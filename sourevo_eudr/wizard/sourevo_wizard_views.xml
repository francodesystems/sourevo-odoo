<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sourevo_dds_submit_view_form" model="ir.ui.view">
        <field name="name">sourevo.dds.submit.form</field>
        <field name="model">sourevo.dds.submit</field>
        <field name="arch" type="xml">
            <form string="Submit to TRACES">
                <div class="alert alert-info" role="status" invisible="not simulated">
                    Your Sourevo account is in trial: the statements go to the simulated TRACES (SIM references) and never reach the Commission.
                </div>
                <div class="alert alert-danger" role="alert" invisible="not has_blocking">
                    There are blocking issues (in red). Fix them in Sourevo or in the receipt and check again.
                </div>
                <field name="summary" readonly="1"/>
                <field name="has_blocking" invisible="1"/>
                <field name="has_warnings" invisible="1"/>
                <field name="simulated" invisible="1"/>
                <div invisible="has_blocking or not has_warnings" class="mt-2">
                    <field name="acknowledge"/>
                    <label for="acknowledge"/>
                </div>
                <footer>
                    <button name="action_submit" type="object" string="Submit to TRACES" class="btn-primary" invisible="has_blocking"
                            data-hotkey="q"/>
                    <button name="action_check_again" type="object" string="Check again" class="btn-secondary"/>
                    <button string="Close" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sourevo_plot_upload_view_form" model="ir.ui.view">
        <field name="name">sourevo.plot.upload.form</field>
        <field name="model">sourevo.plot.upload</field>
        <field name="arch" type="xml">
            <form string="Upload plots">
                <p class="text-muted">
                    A GeoJSON file in WGS84 (Point, Polygon or MultiPolygon; a plot over 4 ha must be a polygon). The
                    properties ProductionPlace, ProducerName, ProducerCountry and Area are read. Each plot is a proposal
                    the supplier confirms, corrects or rejects in its Sourevo portal.
                </p>
                <group>
                    <field name="partner_id"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="country_id" options="{'no_create': True}"/>
                    <field name="producer_name"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Upload" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
