<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sourevo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sourevo</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="97"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Sourevo" id="sourevo_eudr" string="Sourevo" name="sourevo_eudr" groups="base.group_system">
                    <block title="Connection" id="sourevo_connection">
                        <setting string="API key" help="Created in Sourevo, menu API. It starts with svk_. The API is included in the Pro, Forwarder and Enterprise plans; in the 14-day trial it submits to the TRACES test environment (or a simulated TRACES), with numbers that have no legal value.">
                            <div class="content-group mt16">
                                <div class="row">
                                    <label for="sourevo_api_key" string="Key" class="col-lg-3 o_light_label"/>
                                    <field name="sourevo_api_key" password="True"/>
                                </div>
                                <div class="row">
                                    <label for="sourevo_url" string="API URL" class="col-lg-3 o_light_label"/>
                                    <field name="sourevo_url"/>
                                </div>
                                <div class="mt8" invisible="not sourevo_organization">
                                    <span class="text-muted">Connected to </span><field name="sourevo_organization" class="d-inline"/>
                                    <span class="text-muted"> · </span><field name="sourevo_mode" class="d-inline"/>
                                </div>
                                <div class="mt8" invisible="sourevo_api_key">
                                    <span class="text-muted">No account yet? </span>
                                    <a href="https://sourevo.com/?utm_source=odoo&amp;utm_medium=module&amp;utm_campaign=odoo20" target="_blank">Start a free trial in Sourevo</a>
                                </div>
                                <button name="action_sourevo_test" type="object" string="Test connection" class="btn-link" icon="arrow_forward"/>
                            </div>
                        </setting>
                        <setting string="Notifications" help="Sourevo tells Odoo when TRACES gives the reference number, when a supplier answers a plot proposal and when a satellite check flags a plot. This database must be reachable from the internet; if not, the statements are updated every 15 minutes.">
                            <div class="content-group mt16">
                                <div invisible="not sourevo_webhook_url">
                                    <span class="text-muted">Sent to </span><field name="sourevo_webhook_url" class="d-inline"/>
                                </div>
                                <button name="action_sourevo_connect_webhook" type="object" string="Connect notifications" class="btn-link" icon="arrow_forward" invisible="sourevo_webhook_url"/>
                                <button name="action_sourevo_connect_webhook" type="object" string="Connect again" class="btn-link" invisible="not sourevo_webhook_url"/>
                                <button name="action_sourevo_disconnect_webhook" type="object" string="Disconnect" class="btn-link" invisible="not sourevo_webhook_url"/>
                                <div class="mt8">
                                    <span class="text-muted">Last update: </span><field name="sourevo_last_sync" class="d-inline"/>
                                    <button name="action_sourevo_update_now" type="object" string="Update now" class="btn-link"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Due diligence statements" id="sourevo_dds_defaults">
                        <setting string="Company in TRACES" help="The company that submits the statements in TRACES, as set up in Sourevo.">
                            <div class="content-group mt16">
                                <field name="sourevo_operator_id" options="{'no_create': True}"/>
                                <button name="action_sourevo_load_operators" type="object" string="Load companies from Sourevo" class="btn-link"/>
                            </div>
                        </setting>
                        <setting string="Role and activity" help="The defaults of a new statement; each receipt can change them.">
                            <div class="content-group mt16">
                                <div class="row">
                                    <label for="sourevo_operator_role" string="Role" class="col-lg-4 o_light_label"/>
                                    <field name="sourevo_operator_role"/>
                                </div>
                                <div class="row">
                                    <label for="sourevo_activity_type" string="Activity" class="col-lg-4 o_light_label"/>
                                    <field name="sourevo_activity_type"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="sourevo_config_settings_action" model="ir.actions.act_window">
        <field name="name">Sourevo settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'sourevo_eudr', 'bin_size': False}</field>
    </record>
</odoo>
