<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_sourevo" model="ir.ui.view">
        <field name="name">stock.picking.form.sourevo</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="sourevo_eudr_visible" invisible="1"/>
                <field name="sourevo_eudr_pending" invisible="1"/>
                <field name="sourevo_state" invisible="1"/>
                <button name="action_sourevo_prepare" type="object" string="Prepare DDS" class="btn-secondary"
                        groups="stock.group_stock_user" invisible="not sourevo_eudr_visible or not sourevo_eudr_pending"/>
                <button name="action_sourevo_submit" type="object" string="Submit DDS to TRACES" class="btn-primary"
                        groups="stock.group_stock_user" invisible="not sourevo_eudr_visible or sourevo_state != 'draft'"/>
                <button name="action_sourevo_refresh" type="object" string="Update DDS" class="btn-secondary"
                        groups="stock.group_stock_user" invisible="sourevo_state not in ('submitted', 'done', 'problem')"/>
            </xpath>
            <xpath expr="//sheet" position="before">
                <div class="alert alert-success mb-0 text-center" role="status" invisible="not sourevo_references">
                    <strong>EUDR · TRACES: </strong><field name="sourevo_references" class="d-inline fw-bold"/>
                    <span invisible="not sourevo_simulated"> · <em>simulated (Sourevo trial)</em></span>
                </div>
                <div class="alert alert-warning mb-0 text-center" role="status" invisible="sourevo_state != 'problem'">
                    An EUDR statement of this receipt was rejected or withdrawn: see the EUDR tab.
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="EUDR" name="sourevo_eudr" invisible="not sourevo_eudr_visible">
                    <field name="sourevo_dds_ids" context="{'form_view_ref': 'sourevo_eudr.sourevo_dds_view_form'}">
                        <list editable="bottom" create="0" delete="0" decoration-muted="status in ('CANCELLED', 'WITHDRAWN', 'ARCHIVED')"
                              decoration-danger="status == 'REJECTED'">
                            <field name="locked" column_invisible="1"/>
                            <field name="partner_id" column_invisible="1"/>
                            <field name="company_id" column_invisible="1"/>
                            <field name="name" readonly="locked"/>
                            <field name="product_id"/>
                            <field name="quantity" optional="hide"/>
                            <field name="uom_name" optional="hide"/>
                            <field name="net_weight_kg" readonly="locked"/>
                            <field name="volume_m3" optional="hide" readonly="locked"/>
                            <field name="supplementary_qty" optional="hide" readonly="locked"/>
                            <field name="plot_ids" widget="many2many_tags" readonly="locked" options="{'no_create': True}"/>
                            <field name="risk_conclusion" optional="hide" readonly="status != 'new'"/>
                            <field name="status" widget="badge" decoration-success="status == 'AVAILABLE'" decoration-info="status in ('DRAFT', 'SUBMITTED')"/>
                            <field name="reference_number"/>
                            <field name="verification_number"/>
                            <field name="simulated" optional="hide"/>
                            <button name="action_sourevo_discard" type="object" icon="fa-trash" title="Discard"
                                    invisible="status not in ('new', 'DRAFT')"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_sourevo" model="ir.ui.view">
        <field name="name">stock.picking.list.sourevo</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="sourevo_references" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
