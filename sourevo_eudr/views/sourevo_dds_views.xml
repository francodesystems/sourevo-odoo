<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sourevo_dds_view_form" model="ir.ui.view">
        <field name="name">sourevo.dds.form</field>
        <field name="model">sourevo.dds</field>
        <field name="arch" type="xml">
            <form string="EUDR statement" create="0">
                <header>
                    <button name="action_sourevo_refresh" type="object" string="Update" invisible="not sourevo_dds_id"/>
                    <button name="action_sourevo_discard" type="object" string="Discard" invisible="status not in ('new', 'DRAFT')"
                            confirm="The draft is deleted in Sourevo; prepare the receipt again to start over."/>
                    <field name="status" widget="statusbar" statusbar_visible="new,DRAFT,SUBMITTED,AVAILABLE"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="status" invisible="not simulated">
                        Simulated statement (Sourevo trial): it never reached TRACES.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="locked"/></h1>
                    </div>
                    <group>
                        <group string="Goods">
                            <field name="locked" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                            <field name="picking_id"/>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                            <label for="quantity"/>
                            <div class="o_row"><field name="quantity"/><field name="uom_name"/></div>
                            <field name="net_weight_kg" readonly="locked"/>
                            <field name="volume_m3" readonly="locked"/>
                            <field name="supplementary_unit" readonly="locked"/>
                            <field name="supplementary_qty" readonly="locked" invisible="not supplementary_unit"/>
                        </group>
                        <group string="TRACES">
                            <field name="reference_number" class="fw-bold"/>
                            <field name="verification_number" class="fw-bold"/>
                            <field name="traces_uuid" invisible="not traces_uuid"/>
                            <field name="submitting" invisible="not submitting"/>
                            <field name="last_synced"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Statement" name="statement">
                            <group>
                                <group>
                                    <field name="operator_id" readonly="status != 'new'" options="{'no_create': True}"/>
                                    <field name="operator_role" readonly="status != 'new'"/>
                                    <field name="represented_role" readonly="status != 'new'" invisible="operator_role != 'AUTHORISED_REPRESENTATIVE'"/>
                                    <field name="activity_type" readonly="status != 'new'"/>
                                    <field name="country_id" readonly="status != 'new'"/>
                                </group>
                                <group>
                                    <field name="risk_conclusion" readonly="status != 'new'"/>
                                    <field name="risk_notes" readonly="status != 'new'" invisible="not risk_conclusion" required="risk_conclusion"/>
                                    <field name="comment" readonly="status != 'new'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Plots" name="plots">
                            <field name="plot_ids" readonly="locked" options="{'no_create': True}">
                                <list>
                                    <field name="name"/>
                                    <field name="country_code"/>
                                    <field name="area_ha"/>
                                    <field name="proposal_status"/>
                                    <field name="verification_status"/>
                                    <field name="satellite_verdict"/>
                                </list>
                            </field>
                        </page>
                        <page string="Check" name="check" invisible="not check_date">
                            <group>
                                <field name="check_date"/>
                                <field name="check_ready"/>
                                <field name="check_blocking" invisible="not check_blocking" class="text-danger"/>
                                <field name="check_warnings" invisible="not check_warnings" class="text-warning"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sourevo_dds_view_list" model="ir.ui.view">
        <field name="name">sourevo.dds.list</field>
        <field name="model">sourevo.dds</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="status == 'REJECTED'" decoration-muted="status in ('CANCELLED', 'WITHDRAWN', 'ARCHIVED')">
                <field name="name"/>
                <field name="picking_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="net_weight_kg" optional="show"/>
                <field name="status" widget="badge" decoration-success="status == 'AVAILABLE'" decoration-info="status in ('DRAFT', 'SUBMITTED')"/>
                <field name="reference_number"/>
                <field name="verification_number"/>
                <field name="simulated" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="sourevo_dds_view_search" model="ir.ui.view">
        <field name="name">sourevo.dds.search</field>
        <field name="model">sourevo.dds</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="reference_number"/>
                <field name="picking_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <filter string="To submit" name="to_submit" domain="[('status', 'in', ('new', 'DRAFT'))]"/>
                <filter string="Waiting for TRACES" name="waiting" domain="[('status', '=', 'SUBMITTED'), ('reference_number', '=', False)]"/>
                <filter string="In TRACES" name="in_traces" domain="[('reference_number', '!=', False)]"/>
                <filter string="Rejected or withdrawn" name="problem" domain="[('status', 'in', ('REJECTED', 'CANCELLED', 'WITHDRAWN'))]"/>
                <separator/>
                <filter string="Simulated" name="simulated" domain="[('simulated', '=', True)]"/>
                <group>
                    <filter string="Supplier" name="by_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="by_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sourevo_dds_action" model="ir.actions.act_window">
        <field name="name">EUDR statements</field>
        <field name="res_model">sourevo.dds</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No EUDR statements yet</p>
            <p>Mark the products as EUDR (Inventory tab) and, in a receipt of them, click Prepare DDS.</p>
        </field>
    </record>

    <record id="sourevo_plot_view_list" model="ir.ui.view">
        <field name="name">sourevo.plot.list</field>
        <field name="model">sourevo.plot</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="country_code"/>
                <field name="producer_name" optional="show"/>
                <field name="area_ha"/>
                <field name="geometry_type" optional="hide"/>
                <field name="source" optional="hide"/>
                <field name="proposal_status" widget="badge" decoration-danger="proposal_status == 'REJECTED'" decoration-info="proposal_status == 'PENDING'"/>
                <field name="rejection_reason" optional="show"/>
                <field name="verification_status" widget="badge" decoration-success="verification_status == 'VERIFIED'"/>
                <field name="satellite_verdict" widget="badge" decoration-warning="satellite_verdict == 'LOSS_DETECTED'"/>
            </list>
        </field>
    </record>

    <record id="sourevo_plot_view_form" model="ir.ui.view">
        <field name="name">sourevo.plot.form</field>
        <field name="model">sourevo.plot</field>
        <field name="arch" type="xml">
            <form string="EUDR plot" create="0">
                <header>
                    <button name="action_sourevo_verify" type="object" string="Verify" class="btn-primary"
                            invisible="verification_status == 'VERIFIED' or proposal_status in ('PENDING', 'REJECTED')"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="country_code"/>
                            <field name="producer_name"/>
                            <field name="area_ha"/>
                            <field name="geometry_type"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="proposal_status"/>
                            <field name="rejection_reason" invisible="not rejection_reason"/>
                            <field name="verification_status"/>
                            <field name="satellite_verdict"/>
                            <field name="usable"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sourevo_plot_view_search" model="ir.ui.view">
        <field name="name">sourevo.plot.search</field>
        <field name="model">sourevo.plot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Usable" name="usable" domain="[('usable', '=', True)]"/>
                <filter string="Waiting for the supplier" name="pending" domain="[('proposal_status', '=', 'PENDING')]"/>
                <filter string="Rejected" name="rejected" domain="[('proposal_status', '=', 'REJECTED')]"/>
                <filter string="Needs review" name="flagged" domain="[('satellite_verdict', '=', 'LOSS_DETECTED')]"/>
                <group>
                    <filter string="Supplier" name="by_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="sourevo_plot_action" model="ir.actions.act_window">
        <field name="name">EUDR plots</field>
        <field name="res_model">sourevo.plot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No EUDR plots yet</p>
            <p>In a supplier, EUDR tab: send it to Sourevo and upload its plots, or invite it to fill them in its portal.</p>
        </field>
    </record>

    <record id="sourevo_operator_view_list" model="ir.ui.view">
        <field name="name">sourevo.operator.list</field>
        <field name="model">sourevo.operator</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="name"/>
                <field name="country_code"/>
                <field name="eori_number"/>
                <field name="has_credentials"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <menuitem id="menu_sourevo_root" name="EUDR" parent="stock.menu_stock_root" sequence="5"
              groups="stock.group_stock_user"/>
    <menuitem id="menu_sourevo_dds" name="Statements" parent="menu_sourevo_root" action="sourevo_dds_action" sequence="1"/>
    <menuitem id="menu_sourevo_plots" name="Plots" parent="menu_sourevo_root" action="sourevo_plot_action" sequence="2"/>
    <menuitem id="menu_sourevo_settings" name="Settings" parent="menu_sourevo_root" action="sourevo_config_settings_action"
              sequence="10" groups="base.group_system"/>
</odoo>
