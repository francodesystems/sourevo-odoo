<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sourevo_trade_reject_view_form" model="ir.ui.view">
        <field name="name">sourevo.trade.reject.form</field>
        <field name="model">sourevo.trade.reject</field>
        <field name="arch" type="xml">
            <form string="Reject the number">
                <field name="reference_id" invisible="1"/>
                <group>
                    <field name="reason" placeholder="e.g. it is the number of another delivery"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Reject" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
